{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jooevents-docs",
  "main": "./apps/docs-worker/src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "docs.jooevents.com",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 10
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./docs",
    "html_handling": "none",
    "run_worker_first": true
  }
}

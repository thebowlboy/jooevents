{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@jooevents/application": ["../application/src/index.ts"],
      "@jooevents/changesets": ["../changesets/src/index.ts"],
      "@jooevents/contracts": ["../contracts/src/index.ts"],
      "@jooevents/contracts/reviews": ["../contracts/src/reviews.ts"],
      "@jooevents/identity-access": ["../identity-access/src/index.ts"],
      "@jooevents/kernel": ["../kernel/src/index.ts"],
      "@jooevents/review": ["../review/src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts"]
}

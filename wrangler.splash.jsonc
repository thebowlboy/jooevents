{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jooevents-splash",
  "main": "./apps/splash-worker/src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "jooevents.com",
      "custom_domain": true
    },
    {
      "pattern": "www.jooevents.com",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 10
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/splash-worker/public",
    "run_worker_first": true
  }
}

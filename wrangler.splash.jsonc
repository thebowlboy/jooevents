{
  // Preview-only worker: deploys to workers.dev and binds no production
  // domain. Production routing for jooevents.com is managed outside this
  // repository; this checked-in splash is the rollback artifact, and
  // `splash:deploy:cloudflare` deliberately cannot reach the live site.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jooevents-repository-splash-preview",
  "main": "./apps/splash-worker/src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 10
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/splash-worker/public",
    "run_worker_first": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jooevents-demo",
  "main": "./apps/demo-worker/src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 10
  },
  "assets": {
    "directory": "./apps/web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
